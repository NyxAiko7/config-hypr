{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "mpris",
        "hyprland/window"
    ],

   
    "modules-center": [
        "clock",
        "custom/weather"
    ],

    
    "modules-right": [
        "group/hw",
        "group/controls",
        "group/status",
        "custom/notification",
        "group/tools",
        "custom/power"
    ],

    
    "group/hw": {
        "orientation": "inherit",
        "modules": ["cpu", "memory", "disk"]
    },

    "group/controls": {
        "orientation": "inherit",
        "modules": ["backlight", "pulseaudio", "network"]
    },

    "group/status": {
        "orientation": "inherit",
        "modules": ["hyprland/language", "battery"]
    },

    
    "group/tools": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "children-class": "drawer-child",
            "transition-left-to-right": false
        },
        "modules": ["custom/tools-icon", "tray"]
    },

    "custom/tools-icon": {
        "format": "󰍜",
        "tooltip": false
    },

    
    "custom/launcher": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "rofi -show drun || wofi --show drun"
    },

    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": true,
        "format": "{id}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "persistent-workspaces": {
            "*": 4
        }
    },

    "mpris": {
        "format": "{player_icon} {artist} — {title}",
        "format-paused": "{status_icon} {artist} — {title}",
        "format-stopped": "",
        "player-icons": {
            "default": "󰎈",
            "spotify": "",
            "mpv": "󰎈"
        },
        "status-icons": {
            "paused": "󰏤"
        },
        "max-length": 30,
        "tooltip-format": "{player}: {artist} — {title}\n{album}",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 30,
        "separate-outputs": true
    },

    
    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃭 {:%A, %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "today": "<span color='#ff6bcb'><b><u>{}</u></b></span>"
            }
        }
    },

    "custom/weather": {
        "format": "{}",
        "interval": 3600,
        "exec": "curl -s --max-time 5 'https://wttr.in/?format=1'",
        "tooltip": false
    },

    
    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 2,
        "states": { "warning": 70, "critical": 90 },
        "tooltip": true
    },

    "memory": {
        "format": "󰘚 {percentage}%",
        "interval": 2,
        "states": { "warning": 70, "critical": 90 },
        "tooltip-format": "Память: {used:0.1f}GiB / {total:0.1f}GiB"
    },

    "disk": {
        "interval": 30,
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "tooltip-format": "Диск: {free} свободно из {total}"
    },

    
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Mute",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "network": {
        "format-wifi": "{icon} {essid}",
        "format-ethernet": "󰈀 ETH",
        "format-disconnected": "󰤭 Offline",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "max-length": 18,
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\n󰁅 {bandwidthDownBytes}  󰁝 {bandwidthUpBytes}"
    },

    
    "hyprland/language": {
        "format": "󰌌 {}",
        "format-en": "US",
        "format-ru": "RU",
        "on-click": "hyprctl switchxkblayout all next"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}"
    },

    
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󱏧",
            "dnd-none": "󰪑",
            "inhibited-notification": "󱅫",
            "inhibited-none": "󰂜",
            "dnd-inhibited-notification": "󱏧",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "wlogout || shutdown now"
    }
}
