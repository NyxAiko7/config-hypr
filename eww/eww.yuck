;; =========================================================================
;; Переменные и опросы (Polls / Listens)
;; =========================================================================

(defpoll time :interval "1s" "date '+%H:%M:%S'")
(defpoll date :interval "1m" "date '+%d.%m.%Y'")
(defpoll memory :interval "3s" "free -m | awk '/Mem:/ { printf(\"%.0f\", $3/$2 * 100) }'")
(defvar show_date false)

(defpoll dnd_status :interval "1s"
  "swaync-client -D")
(defpoll notif_count :interval "1s"
  "swaync-client -c")

(defpoll weather_temp :interval "30m"
  "curl -s 'wttr.in?format=%t' | tr -d '+' 2>/dev/null || echo 'N/A'")

(defpoll weather_icon :interval "30m"
  "curl -s 'wttr.in?format=%c' | awk '{print $1}' 2>/dev/null || echo '󰖐'")

(defpoll cpu_usage :interval "2s" "top -bn1 | grep 'Cpu(s)' | awk '{print int($2 + $4)}'")

(defpoll brightness :interval "1s"
  "brightnessctl -m 2>/dev/null | cut -d',' -f4 | tr -d '%' || echo '100'")

(defpoll kb_layout :interval "1s"
  "hyprctl devices -j | jq -r '.keyboards[] | select(.main == true) | .active_keymap' | cut -c1-2 | tr '[:lower:]' '[:upper:]'")

(defpoll volume :interval "1s"
  "wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{print int($2 * 100)}'")

(deflisten workspaces_widgets
  "~/.config/eww/scripts/get-workspaces.sh")

(defpoll battery :interval "10s"
  "cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo '100'")
(defpoll bat_status :interval "10s"
  "cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo 'Full'")

(defpoll net_ssid :interval "5s"
  "nmcli -t -f active,ssid dev wifi 2>/dev/null | grep '^yes' | cut -d: -f2 || ip route | grep default | awk '{print $5}'")
(defpoll net_status :interval "5s"
  "cat /sys/class/net/w*/operstate 2>/dev/null | grep -q 'up' && echo 'online' || (cat /sys/class/net/e*/operstate 2>/dev/null | grep -q 'up' && echo 'online' || echo 'offline')")

;; =========================================================================
;; Определение отделяемых виджетов
;; =========================================================================

(defwidget notification_toggle []
  (button :class "notif-btn" 
          :onclick "swaync-client -t -sw" 
    (box :orientation "h" :space-evenly false :spacing 6
      (label :text {dnd_status == "true" ? "󰂛" : (notif_count > 0 ? "󰂚" : "󰂜")})
      (label :text "${notif_count}" :visible {notif_count > 0}))))

(defwidget sidebar_btn []
  (button :class "sidebar-btn"
          :onclick "eww open --toggle controlpanel"
    (label :text "󰍜")))

;; Виджет громкости
(defwidget volume_widget []
  (eventbox :onscroll "if [ '{}' = 'up' ]; then wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+; else wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; fi"
            :onclick "pavucontrol &"
    (label :text "󰕾 ${volume}%" :class "vol-label")))

;; Виджет погоды
(defwidget weather_widget []
  (eventbox :onclick "kitty -e curl wttr.in &"
    (label :text "${weather_icon} ${weather_temp}" :class "weather-label")))

;; Виджет батареи
(defwidget battery_widget []
  (label :text "${bat_status == 'Charging' ? '󰂄' : '󰁹'} ${battery}%" :class "bat-label"))

;; Виджет сети
(defwidget wifi_widget []
  (label :text "${net_status == 'online' ? '󰤨 ' + (net_ssid != '' ? net_ssid : 'Eth') : '󰤭 Off'}" :class "net-label"))

;; Виджет яркости
(defwidget bright_widget []
  (eventbox :onscroll "if [ '{}' = 'up' ]; then brightnessctl set +5%; else brightnessctl set 5%-; fi"
    (label :text "󰃠 ${brightness}%" :class "bright-label")))

;; =========================================================================
;; Основные секции панели
;; =========================================================================

;; Левая секция (Воркспейсы)
(defwidget left []
  (box :orientation "h" :space-evenly false :halign "start" :spacing 10
    (literal :content workspaces_widgets)))

;; Центральная секция (Время / Дата по клику)
(defwidget center []
  (box :orientation "h" :space-evenly false :halign "center" :spacing 8
    (weather_widget)
    (button :class "date-btn"
            :onclick "eww update show_date=${!show_date}"
      (label :text "${show_date ? '󰸗 ' + date : '󰥔 ' + time}"))
    (notification_toggle)
))

;; Правая секция (Индикаторы + Tray)
(defwidget right []
  (box :orientation "h" :space-evenly false :halign "end" :spacing 12
    (label :text "󰌌 ${kb_layout}" :class "layout-label")
    (wifi_widget)
    (bright_widget)
    (volume_widget)
    (label :text "󰍛 ${memory}%" :class "ram-label")
    (battery_widget)
    (systray :class "tray"
             :pack-direction "left"
             :icon-size 16
             :spacing 8)
    (sidebar_btn)
    (button :class "power-btn" :onclick "poweroff" "󰐥")))

;; Главное устройство компоновки
(defwidget bar_layout []
  (centerbox :orientation "h" :class "bar-inner"
    (left)
    (center)
    (right)))

;; =========================================================================
;; Control Center Widget & Window
;; =========================================================================

(defwidget control_panel []
  (box :orientation "v" :space-evenly false :class "control-panel-box" :spacing 14

    ;; Карточка пользователя / системы
    (box :orientation "h" :space-evenly false :class "user-card" :spacing 12
      (label :text "󰣇" :class "os-icon")
      (box :orientation "v" :space-evenly false
        (label :text "Artix Linux" :class "user-title" :halign "start")
        (label :text "Hyprland Session" :class "user-sub" :halign "start")))

    ;; Ползунок Громкости
    (box :orientation "v" :space-evenly false :class "slider-section" :spacing 4
      (box :orientation "h" :space-evenly false
        (label :text "󰕾 Громкость" :class "slider-title" :halign "start")
        (label :text "${volume}%" :class "slider-val" :halign "end"))
      (scale :class "cc-slider"
             :value volume
             :min 0
             :max 101
             :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ $(awk -v v={} 'BEGIN {print v/100}')"))

    ;; Ползунок Яркости
    (box :orientation "v" :space-evenly false :class "slider-section" :spacing 4
      (box :orientation "h" :space-evenly false
        (label :text "󰃠 Яркость" :class "slider-title" :halign "start")
        (label :text "${brightness}%" :class "slider-val" :halign "end"))
      (scale :class "cc-slider"
             :value brightness
             :min 1
             :max 101
             :onchange "brightnessctl set {}%"))

    ;; Мониторинг ресурсов (RAM / CPU)
    (box :orientation "h" :space-evenly true :class "stats-box" :spacing 8
      (box :orientation "v" :space-evenly false :class "stat-card"
        (label :text "󰍛 ОЗУ" :class "stat-title")
        (label :text "${memory}%" :class "stat-value"))
      (box :orientation "v" :space-evenly false :class "stat-card"
        (label :text "󰻠 CPU" :class "stat-title")
        (label :text "${cpu_usage}%" :class "stat-value")))

    ;; Быстрые действия
    (box :orientation "h" :space-evenly true :class "actions-box" :spacing 8
      (button :class "action-btn" :onclick "kitty -e nmtui &" "󰤨 Wi-Fi")
      (button :class "action-btn" :onclick "pavucontrol &" "󰓃 Звук")
      (button :class "action-btn" :onclick "hyprpicker -a &" "󰈋 Пипетка"))

    ;; Кнопка выключения
    (box :orientation "h" :space-evenly true :class "power-box" :spacing 8
      (button :class "power-card off" :onclick "poweroff" "󰐥 Выключить")
      (button :class "power-card reboot" :onclick "reboot" "󰜉 Перезагрузить"))
  )
)

;; Окно всплывающей панели
(defwindow controlpanel
    :monitor 0
    :stacking "fg"
    :geometry (geometry :x "10px"
                        :y "3px"
                        :width "300px"
                        :anchor "top right")
    (control_panel))

;; =========================================================================
;; Главное окно панели
;; =========================================================================

(defwindow bar
    :monitor 0
    :stacking "fg"
    :exclusive true
    :geometry (geometry :x "0%"
                        :y "0%"
                        :width "100%"
                        :height "40px"
                        :anchor "top center")
    (bar_layout))
